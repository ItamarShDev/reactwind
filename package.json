{
  "name": "@itamarshdev/reactwind",
  "version": "1.3.0",
  "description": "JSX runtime wrapper that adds a classNames prop to React elements.",
  "keywords": [
    "css-in-js",
    "jsx",
    "react",
    "runtime",
    "shorthand",
    "styling",
    "tailwind",
    "tailwindcss"
  ],
  "homepage": "https://ItamarShDev.github.io/reactwind/storybook/",
  "bugs": {
    "url": "https://github.com/ItamarShDev/reactwind/issues"
  },
  "license": "MIT",
  "author": "ItamarShDev",
  "repository": {
    "type": "git",
    "url": "https://github.com/ItamarShDev/reactwind.git"
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js",
      "require": "./dist/jsx-runtime.cjs"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js",
      "require": "./dist/jsx-dev-runtime.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup src/index.ts src/jsx-runtime.ts src/jsx-dev-runtime.ts --format esm,cjs --dts --clean",
    "prepublishOnly": "bun run build && bun run test",
    "test": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "lint": "oxlint",
    "format": "oxfmt --write src",
    "check": "oxfmt --check src",
    "test:watch": "vitest --project unit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "generate:types": "node scripts/gen-types.js",
    "test:types": "tsc -p tests/tsconfig.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "happy-dom": "^21.0.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semantic-release": "^25.0.9",
    "storybook": "10.6.2",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "packageManager": "bun@1.4.3"
}
